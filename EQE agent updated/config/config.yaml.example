default_env: qa
browser: chromium
timeout_ms: 15000
workers: auto
headless: true
verify_ssl: false
app_version: null  # Set to override automatic detection (e.g., "1.2.3")

# qTest defect integration — auto-creates a defect in qTest when a test fails.
# Copy this file to config.yaml and fill in your real values.
qtest:
  enabled: true
  host: "qtest-prd.caresource.corp"
  token: "YOUR_QTEST_API_TOKEN_HERE"   # <-- replace with your token
  project_id: 1
  ssl_verify: false
  attach_screenshot: true   # Attach failure screenshot to the qTest defect
environments:
  dev:
    base_url: "https://docu-chat-dev.crt.ai.caresource.corp/"
    app_version: null
  qa:
    base_url: "https://docu-chat.crt.ai.caresource.corp/"
    app_version: null
  uat:
    base_url: "https://docu-chat-uat.crt.ai.caresource.corp/"
    app_version: null
  int:
    base_url: "https://csgpt.int.ai.caresource.corp/"
    app_version: null
    auth:
      storage_state: "config/.auth/int_storage_state.json"
      login_url: "https://csgpt.int.ai.caresource.corp/"
      wait_for_url_pattern: "*csgpt.int.ai.caresource*"
      session_ttl_hours: 4  # re-auth after this many hours
