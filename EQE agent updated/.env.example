# API framework settings
# API host used by API tests. Keep this separate from the UI host in config/config.yaml.
API_BASE_URL=https://api.int.ai.caresource.corp/
API_APPLICATION=replace-with-application-header-value
API_CS_CLIENT_PRINCIPAL=replace-with-cs-client-principal-value


# Enterprise API profile
ENTERPRISE_API_BASE_URL=https://api.int.ai.caresource.corp/enterprise/docs/v1/swagger/#/
ENTERPRISE_API_APPLICATION=replace-with-application-header-value
ENTERPRISE_API_CS_CLIENT_PRINCIPAL=replace-with-cs-client-principal-value
ENTERPRISE_API_AUTHORIZATION=Bearer replace-with-token

# qTest defect integration
QTEST_HOST=replace-with-qtest-host
QTEST_TOKEN=replace-with-qtest-token
QTEST_PROJECT_ID=replace-with-qtest-project-id

# Copy this file to .env or .env.local and fill in your local-only secrets.
# These files are gitignored and should never be committed.

# INT database
INT_PGHOST=pgsql-pantheon-northcentral-int-01.postgres.database.azure.com
INT_PGPORT=5432
INT_PGDATABASE=postgres
INT_PGUSER=adminlogin
INT_PGPASSWORD=YOUR_INT_PASSWORD
INT_PGSSLMODE=require

# CRT database (used by qa/uat/dev unless you define env-specific overrides)
CRT_PGHOST=pgsql-pantheon-northcentral-crt-01.postgres.database.azure.com
CRT_PGPORT=5432
CRT_PGDATABASE=pgsqldb-pantheon-eastus-crt-01
CRT_PGUSER=adminlogin
CRT_PGPASSWORD=YOUR_CRT_PASSWORD
CRT_PGSSLMODE=require